# =========================================
# HỆ THỐNG ĐIỂM DANH AI - THPT ĐIỀU CẢI
# Cấu hình môi trường (Environment Variables)
# =========================================

# === AUTH & SECURITY ===
JWT_SECRET=change-me-diemdanh-dieucai-random-secret-key
JWT_EXPIRE_HOURS=4320 

# Admin khởi tạo (tạo tự động khi DB trống)
ADMIN_EMAIL=admin@truongdieucai.edu.vn
ADMIN_PASSWORD=Admin@2025
ADMIN_FULL_NAME=Quản trị hệ thống

# === CẤU HÌNH TÊN MIỀN & TRUY CẬP (DOMAIN & PUBLIC URL) ===
# Tên miền hoặc URL chính thức của hệ thống (dùng cho link email reset mật khẩu và CORS):
# - Chạy cục bộ: http://localhost:3000
# - Triển khai VPS / tên miền: https://eyeai.share4happy.com
APP_PUBLIC_URL=http://localhost:3000

# CORS Origins: các tên miền được phép gọi API (phân cách dấu phẩy)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Cookie HTTPS: đặt 'true' nếu chạy tên miền HTTPS có chứng chỉ SSL, đặt 'false' nếu chạy http cục bộ
COOKIE_SECURE=false

# === DATABASE CƠ SỞ DỮ LIỆU ===
# Mặc định sử dụng SQLite cục bộ trong data/database (tương thích 100% backup Google Drive):
DATABASE_URL=sqlite:///data/database/attendance.db
# Tùy chọn nếu chạy PostgreSQL trong Docker:
# DATABASE_URL=postgresql://postgres:dieucai_secure_pass_2026@db:5432/attendance_db

# === EMAIL (SMTP) ===
# Gửi email báo cáo và reset mật khẩu
SMTP_USER=admin@truongdieucai.edu.vn
SMTP_PASSWORD=
PRINCIPAL_EMAIL=hieutruong@truongdieucai.edu.vn

# === ZALO NOTIFICATION (Tùy chọn) ===
ZALO_BOT_API_BASE_URL=https://sms-service.talab.io.vn/api/gateway/v1.0
ZALO_BOT_ID=
ZALO_BOT_API_KEY=

# === GOOGLE DRIVE BACKUP (Tùy chọn) ===
# 1) Vào https://console.cloud.google.com/apis/credentials
# 2) Create Credentials → OAuth client ID → Application type: Desktop App
# 3) Copy Client ID + Client Secret dán vào 2 dòng dưới
GOOGLE_DRIVE_CLIENT_ID=299323606176-2eofcr6do689jlpati17podid3206nn4.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=
# ID thư mục Drive muốn lưu (bỏ trống = thư mục gốc "My Drive")
GOOGLE_DRIVE_FOLDER_ID=
# URI người dùng được redirect sau khi đồng ý (Desktop App mặc định)
GOOGLE_DRIVE_REDIRECT_URI=http://localhost
# true = Chỉ lưu trên Drive (xoá bản zip local sau khi upload thành công)
GOOGLE_DRIVE_REMOTE_ONLY=true

# === AI COMPUTER VISION (YOLO26m) ===
YOLO_MODEL_NAME=models/yolo26m.pt
YOLO_IMGSZ=1280
AI_CONFIDENCE_THRESHOLD=0.25
AI_IOU_THRESHOLD=0.50

# =========================================
# LƯU Ý:
# - Đổi JWT_SECRET thành chuỗi ngẫu nhiên dài
# - Đặt ADMIN_PASSWORD mạnh cho lần khởi động đầu
# - Cấu hình SMTP_PASSWORD để kích hoạt gửi email
# - Sao lưu Google Drive: điền GOOGLE_DRIVE_CLIENT_ID/SECRET rồi vào
#   trang Báo cáo → tab Cài đặt → phần "Sao Lưu Google Drive" → Kết Nối
# =========================================